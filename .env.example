# Canonical site origin (optional — defaults to https://getpairo.app)
# VITE_SITE_URL=

# Web PWA URL for the primary CTA (legacy variable name)
VITE_PEAR_APP_URL=

# PostHog project API key (public — bundled into the client). Falls back to the shared
# marketing-site key when unset.
# VITE_POSTHOG_KEY=
